class Solution {
    public int maxProfit(int[] prices) {
         int lowestPrice = Integer.MAX_VALUE;
         int bestProfit = 0;
         for (int i = 0; i < prices.length; i++) {
            if (prices[i] < lowestPrice) {
                lowestPrice = prices[i];
            } else {
                int profit = prices[i] - lowestPrice;
                if (profit > bestProfit) {
                    bestProfit = profit;
                }
            }
        }
        return bestProfit;
    }
}
