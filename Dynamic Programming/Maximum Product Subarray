class Solution {
    public int maxProduct(int[] nums) {
        int left = 1;
        int right = 1;
        int result = nums[0];
        for (int i = 0; i < nums.length; i++) {
            if (left == 0) {
                left = 1;
            }
            if (right == 0) {
                right = 1;
            }
            left *= nums[i];
            right *= nums[nums.length - 1 - i];
            result = Math.max(result, Math.max(left, right));
        }
        return result;
    }
}
    
