class Solution {
    public boolean isIsomorphic(String s, String t) {
      int[] first = new int[128];
        int[] second = new int[128];
        for (int i = 0; i < s.length(); i++) {
            char ch1 = s.charAt(i);
            char ch2 = t.charAt(i);
            if (first[ch1] != second[ch2]) {
                return false;
            }
            first[ch1] = i + 1;
            second[ch2] = i + 1;
        }
        return true;
    }
}  
    
