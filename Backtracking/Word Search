class Solution {
    public boolean exist(char[][] board, String word) {
          for (int i = 0; i < board.length; i++) {
            for (int j = 0; j < board[0].length; j++) {
                if (board[i][j] == word.charAt(0)) {
                    if (check(board, word, i, j, 0)) {
                        return true;
                    }
                }
            }
        }
        return false;
    }
    private boolean check(char[][] board, String word, int i, int j, int pos) {
        if (pos == word.length()) {
            return true;
        }
        if (i < 0 || j < 0 || i >= board.length ||
            j >= board[0].length || board[i][j] != word.charAt(pos)) {
            return false;
        }
        char old = board[i][j];
        board[i][j] = '#';
        boolean ok = check(board, word, i + 1, j, pos + 1)
                  || check(board, word, i - 1, j, pos + 1)
                  || check(board, word, i, j + 1, pos + 1)
                  || check(board, word, i, j - 1, pos + 1);
        board[i][j] = old;
        return ok;
    }
}
    
